# Database
POSTGRES_USER=cuanbot
POSTGRES_PASSWORD=cuanbot_secure_password_change_me
POSTGRES_DB=cuanbot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cuanbot:cuanbot_secure_password_change_me@postgres:5432/cuanbot_db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-ngrok-url.ngrok.io/webhook/telegram

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Backend
BACKEND_PORT=8000
SECRET_KEY=your_secret_key_here_change_in_production

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Ngrok
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
